# Build outputs — catch all modules with a single pattern.
# This already covers the generated documentation site under docsite/build/.
**/build/
**/build

# Left over from the abandoned MkDocs attempt; the site is generated by :docsite now
/site/
.cache/

# Documentation screenshots, drawn from the real library by :docsite:generateDocsImages on every
# site build. Not committed on purpose: a checked-in picture of a calendar is correct until the
# next change to the calendar, and nothing tells you when it stops being correct.
/docs/images/

# Gradle
.gradle/
gradle/wrapper/gradle-wrapper.jar
local.properties

# IntelliJ / Android Studio
*.iml
.idea/
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Kotlin
.kotlin/

# macOS
.DS_Store
**/.DS_Store

# Android
/captures
.externalNativeBuild
.cxx

# Node / WASM JS (generated by the Kotlin/WASM or Kotlin/JS compilation)
**/node_modules/

# Claude Code session data
.claude/

# Local engineering decision log — deliberately never committed
DECISIONS.md
